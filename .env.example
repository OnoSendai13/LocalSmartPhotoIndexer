# Local Smart Photo Indexer - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# OLLAMA CONFIGURATION (Default - Local)
# ===========================================
# Default Ollama server URL (only needed if not localhost)
# VITE_OLLAMA_URL=http://localhost:11434

# ===========================================
# OPENROUTER CONFIGURATION (Cloud Alternative)
# ===========================================
# Get your API key at: https://openrouter.ai/keys
# VITE_OPENROUTER_API_KEY=sk-or-v1-...

# ===========================================
# GOOGLE GEMINI CONFIGURATION (Cloud Alternative)
# ===========================================
# Get your API key at: https://aistudio.google.com/apikey
# VITE_GEMINI_API_KEY=AIza...

# ===========================================
# OPENAI CONFIGURATION (Cloud Alternative)
# ===========================================
# Get your API key at: https://platform.openai.com/api-keys
# VITE_OPENAI_API_KEY=sk-...
